# Local environment / secrets
# app/config/env.php ikut di-commit sebagai profil pratinjau (tanpa kredensial).
# Kredensial produksi: pakai environment variables HRIS_* atau berkas .env.
.env

# Runtime storage
storage/logs/*.log
storage/cache/*
storage/uploads/*
storage/database.sqlite
storage/*.sqlite
storage/exports/*
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/uploads/.gitkeep
!storage/exports/.gitkeep

# Preview runtime (php-wasm, installed on demand)
tools/preview/node_modules
tools/preview/package-lock.json

# phpqrcode runtime logs
vendor/phpqrcode/*-errors.txt
vendor/phpqrcode/cache/*.dat

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Generated by tools/preview at runtime
public/_install.php
public/_router.php
public/_status.php
